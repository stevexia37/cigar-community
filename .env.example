# ============================================================
# 雪茄客 · 环境变量模板
# 用法：cp .env.example .env  然后按需修改
# .env 已被 .gitignore 忽略，凭证不会进版本库
# ============================================================

# ---------- 服务 ----------
CC_PORT=8787
CC_HOST=127.0.0.1

# ---------- 密钥（生产环境必须替换）----------
# 生成方式： node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CC_SECRET=change-me-in-production-please-use-32-bytes

# ---------- 数据库 ----------
# 默认 database/cigar.db（SQLite，零运维，适合本地/单机部署）
CC_DB_PATH=database/cigar.db
# 生产环境如改用 MySQL，可在此填连接串（当前版本尚未接入，见 docs/ROADMAP.md）
# CC_MYSQL_URL=mysql://user:pass@localhost:3306/cigar_community

# ---------- 初始管理员（首次启动自动创建，仅当 users 表为空时）----------
CC_ADMIN_USER=admin
CC_ADMIN_PASSWORD=admin12345

# ---------- 运行模式 ----------
# development | production
CC_ENV=development

# 反向代理层数。默认 0 = 不信任 X-Forwarded-For。
# ⚠️ 仅在确实部署于反向代理之后时才调大，否则攻击者可伪造 XFF 绕过限流：
#   · 只有 Nginx                 → 1
#   · Cloudflare + Nginx         → 2
#   · 直接暴露 Node（无代理）     → 保持 0
CC_TRUST_PROXY=0

# ---------------------------------------------------------------- 年龄门
# 服务端强制 18+ 年龄门（未过门时 /api/* 返回 403 AGE_GATE_REQUIRED）。
# 默认开启，仅用于自动化测试；生产环境不要设置。
# 豁免：爬虫 UA、/api/health、/api/auth/me、/api/gate/verify 自身、已登录用户。
# CC_AGE_GATE_DISABLED=1
