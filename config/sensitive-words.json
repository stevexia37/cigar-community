      ]
    }
  },
  "compound_rules": {
    "_note": [
      "组合规则：当一条内容同时命中「A 组任一」与「B 组任一」时，直接判为 blocked。",
      "这是替代「把日常词一股脑塞进红线」的正确做法 —— 精度来自组合，而不是单词表。",
      "注意：每个 A 词都必须出现在 B 词的邻近窗口内，且该 A 词命中处不得处于安全语境",
      "（否则「遇到代购私聊请举报」会被误判为交易信息）。"
    ],
    "_action": "blocked",
    "rules": [
      {
        "name": "交易意图 + 联系方式",
        "any_of_a": [
          "出茄",
          "出雪茄",
          "现货",
          "有货",
          "清仓",
          "低价",
          "转手",
          "转让",
          "拼单",
          "代购",
          "私聊",
          "私我",
          "出售",
          "出掉"
        ],
        "any_of_b": [
          "微信",
          "加微",
          "vx",
          "wx",
          "wechat",
          "qq",
          "电话",
          "手机号",
          "扫码",
          "转账",
          "支付宝",
          "收款",
          "联系我"
        ],
        "window": 40,
        "exempt_in_safe_context": true
      },
      {
        "name": "询价 + 交易意图",
        "any_of_a": [
          "多少钱",
          "多少一支",
          "报价",
          "什么价"
        ],
        "any_of_b": [
          "一支",
          "一条",
          "一盒",
          "现货",
          "有货",
          "收",
          "卖"
        ],
        "window": 25,
        "exempt_in_safe_context": true,
        "escalate_to": "queued",
        "_why": "询价本身不是违规，只应进人工审核队列；红线留给「交易意图+联系方式」这类明确的交易行为。"
      }
    ]
  },
  "whitelist": {
    "_note": "豁免规则。核心约束：豁免必须基于「命中词邻近的上下文」，不能因为整句出现过某个词就豁免。",
    "_why": "早期实现用「句内出现豁免词即豁免整句」，结果「违规出茄加微信」被完全豁免（实测 clean）。现在改为邻近窗口判定。",
    "patterns": {
      "_note": "完全放行的短语：命中词若落在这些短语内部，不触发过滤",
      "list": [
        "参考市场价",
        "建议零售价",
        "MSRP",
        "历史价格"
      ]
    },
    "negation": {
      "_note": "否定词必须紧邻命中词之前（同窗口内且中间无标点/无其他词）才豁免完整命中",
      "list": [
        "不卖",
        "不出",
        "没有",
        "不提供",
        "禁止",
        "严禁",
        "拒绝",
        "请勿",
        "勿",
        "不做",
        "从不",
        "不"
      ]
    },
    "safe_context": {
      "_note": "安全语境分两类，窗口策略不同：discourse（举报/防骗…）语义上作用于整句，但为避免「一句废话豁免全句」，实现按子句邻近判定（命中词前后 _discourse_window 字以内），不跨子句；format（切勿/微信…）只作用于邻近词，窗口为 _window。弱词（审核/案例/提醒）已从豁免表移除 —— 攻击者会主动写「审核通过」当作豁免钥匙。",
      "_window": 8,
      "_discourse_window": 12,
      "exemptors": [
        "举报",
        "打击",
        "谨防",
        "警惕",
        "防骗",
        "被骗",
        "骗局",
        "切勿",
        "别信",
        "违法",
        "风控",
        "别上当",
        "黑名单",
        "避坑",
        "防坑",
        "曝光",
        "诈骗",
        "维权",
        "辟谣"
      ],
      "_exemptors_note": "豁免词必须与「违规词」语义相反（保护/警示），绝不能包含联系方式或交易词。历史上把 微信/加微/私聊/转账 放进豁免表，导致这些词互相豁免，交易信息整段放行（实测 6 类绕过全部漏放）。",
      "_never_exempt": [
        "微信",
        "加微",
        "vx",
        "wx",
        "wechat",
        "威信",
        "薇信",
        "手机号",
        "电话",
        "转账",
        "支付宝",
        "收款",
        "扫码",
        "私聊",
        "私我",
        "私信",
        "联系我"
      ],
      "_exempt_window": 12
    }
  },
  "variants": {
