{
  "name": "cigar-community",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "雪茄客社区 · 非烟草交易向的雪茄知识库与品吸交流平台",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "setup": "npm install",
    "dev": "node --watch server/index.js",
    "dev:web": "npm --prefix web run dev",
    "start": "node server/index.js",
    "seed": "node scripts/seed.mjs",
    "seed:reset": "node scripts/seed.mjs --reset",
    "build": "npm --prefix web run build",
    "test": "node --test scripts/",
    "test:e2e": "bash scripts/test-e2e.sh",
    "smoke": "bash scripts/api-smoke.sh",
    "preflight": "bash scripts/preflight.sh",
    "backup": "bash scripts/backup-db.sh",
    "verify:ui": "node scripts/verify-ui.mjs",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "workspaces": [
    "web"
  ]
}
